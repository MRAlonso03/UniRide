<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.UniRide" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/navy</item>
        <item name="colorPrimaryVariant">@color/blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/sky</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/off_white</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- Estilo para campos de texto -->
    <style name="UniRide.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/blue</item>
        <item name="hintTextColor">@color/navy</item>
    </style>

    <!-- Botón primario -->
    <style name="UniRide.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/navy</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- Botón secundario -->
    <style name="UniRide.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/navy</item>
        <item name="android:textColor">@color/navy</item>
        <item name="cornerRadius">8dp</item>
    </style>
</resources>